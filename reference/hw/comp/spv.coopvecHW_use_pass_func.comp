    doVecMul(param, param_1);
    coopmatHW<float16_t, 16u, 16u> param_2 = M;
    coopvecHW<float16_t, 16u> param_3 = v0;
    coopvecHW<float16_t, 16u> bias;
    coopvecHW<float16_t, 16u> param_4 = bias;
    doVecMulAdd(param_2, param_3, param_4);
}

