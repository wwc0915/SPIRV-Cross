void doVecMul(coopmatHW<float16_t, 16u, 16u> mat, coopvecHW<float16_t, 16u> vin)
{
    coopvecHW<float16_t, 16u> _29;
    coopVecMatMulHW(_29, vin, coopmatHW<float16_t, 16u, 16u>(mat));
    coopvecHW<float16_t, 16u> tempArg = _29;
    coopvecHW<float16_t, 16u> result = tempArg;
}

void doVecMulAdd(coopmatHW<float16_t, 16u, 16u> mat, coopvecHW<float16_t, 16u> vin, coopvecHW<float16_t, 16u> bias)
{
    coopvecHW<float16_t, 16u> _36;
    coopVecMatMulHW(_36, vin, coopmatHW<float16_t, 16u, 16u>(mat));
    coopvecHW<float16_t, 16u> tempArg = _36;
    coopvecHW<float16_t, 16u> r1 = tempArg;
    coopvecHW<float16_t, 16u> _44;
    coopVecMatMulAddHW(_44, vin, coopmatHW<float16_t, 16u, 16u>(mat), bias);
    coopvecHW<float16_t, 16u> tempArg_1 = _44;
    coopvecHW<float16_t, 16u> r2 = tempArg_1;
}

void main()
{
    coopmatHW<float16_t, 16u, 16u> _60;
    coopMatLoadHW(_60, buf.data, ivec2(16), ivec2(0), gl_CooperativeMatrixLayoutRowMajorHW);
    coopmatHW<float16_t, 16u, 16u> tempArg = _60;
    coopmatHW<float16_t, 16u, 16u> M = tempArg;
    coopmatHW<float16_t, 16u, 16u> param = M;
