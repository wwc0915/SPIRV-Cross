#version 450
#if defined(GL_AMD_gpu_shader_half_float)
#extension GL_AMD_gpu_shader_half_float : require
#elif defined(GL_EXT_shader_explicit_arithmetic_types_float16)
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#else
#error No extension available for FP16.
#endif
#extension GL_EXT_shader_16bit_storage : require
#extension GL_HW_neural_shader : require
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Buf
{
    float16_t data[];
} buf;

coopmatHW<float16_t, 16u, 16u> makeAcc(coopmatHW<float16_t, 16u, 16u> A, coopmatHW<float16_t, 16u, 16u> B, coopmatHW<float16_t, 16u, 16u> C)
{
    coopmatHW<float16_t, 16u, 16u> _90;
    coopMatMulAddHW(_90, A, coopmatHW<float16_t, 16u, 16u>(B), coopmatHW<float16_t, 16u, 16u>(C));
    coopmatHW<float16_t, 16u, 16u> tempArg = _90;
    coopmatHW<float16_t, 16u, 16u> D = tempArg;
    return coopmatHW<float16_t, 16u, 16u>(D);
}

coopmatHW<float16_t, 16u, 16u> wrapper(coopmatHW<float16_t, 16u, 16u> A, coopmatHW<float16_t, 16u, 16u> B, coopmatHW<float16_t, 16u, 16u> C)
{
    coopmatHW<float16_t, 16u, 16u> param = A;
    coopmatHW<float16_t, 16u, 16u> param_1 = B;
    coopmatHW<float16_t, 16u, 16u> param_2 = C;
    return makeAcc(param, param_1, param_2);
}

void main()
{
    coopmatHW<float16_t, 16u, 16u> _44;
    coopMatLoadHW(_44, buf.data, ivec2(16), ivec2(0), gl_CooperativeMatrixLayoutRowMajorHW);
    coopmatHW<float16_t, 16u, 16u> tempArg = _44;
    coopmatHW<float16_t, 16u, 16u> A = tempArg;
    coopmatHW<float16_t, 16u, 16u> _49;
    coopMatLoadHW(_49, buf.data, ivec2(16), ivec2(0), gl_CooperativeMatrixLayoutRowMajorHW);
    coopmatHW<float16_t, 16u, 16u> tempArg_1 = _49;
    coopmatHW<float16_t, 16u, 16u> B = tempArg_1;
    coopmatHW<float16_t, 16u, 16u> _54;
    coopMatLoadHW(_54, buf.data, ivec2(16), ivec2(0), gl_CooperativeMatrixLayoutRowMajorHW);
    coopmatHW<float16_t, 16u, 16u> tempArg_2 = _54;
    coopmatHW<float16_t, 16u, 16u> C = tempArg_2;
    coopmatHW<float16_t, 16u, 16u> _61;
    coopMatLoadHW(_61, buf.data, ivec2(16), ivec2(0), gl_CooperativeMatrixLayoutRowMajorHW);
    coopmatHW<float16_t, 16u, 16u> tempArg_3 = _61;
    coopmatHW<float16_t, 16u, 16u> B2 = tempArg_3;
    coopmatHW<float16_t, 16u, 16u> _68;
    coopMatLoadHW(_68, buf.data, ivec2(16), ivec2(0), gl_CooperativeMatrixLayoutRowMajorHW);
    coopmatHW<float16_t, 16u, 16u> tempArg_4 = _68;
    coopmatHW<float16_t, 16u, 16u> C2 = tempArg_4;
    coopmatHW<float16_t, 16u, 16u> param = A;
    coopmatHW<float16_t, 16u, 16u> param_1 = B;
    coopmatHW<float16_t, 16u, 16u> param_2 = C;
    coopmatHW<float16_t, 16u, 16u> _81;
    coopMatMulAddHW(_81, wrapper(param, param_1, param_2), B2, C2);
    coopmatHW<float16_t, 16u, 16u> tempArg_5 = _81;
    coopmatHW<float16_t, 16u, 16u> D1 = tempArg_5;
}

