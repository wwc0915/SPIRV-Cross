#version 450 core
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_HW_neural_shader : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Buf { float16_t data[]; } buf;

struct MatBox {
    coopmatHW<float16_t, 16, 16> value;
};

void main()
{
    const ivec2 shape = ivec2(16, 16);
    const ivec2 zeroOffset = ivec2(0, 0);

    coopmatHW<float16_t, 16, 16> lhs[2];
    coopmatHW<float16_t, 16, 16> rhs[2];
    coopmatHW<float16_t, 16, 16> acc[2];
    coopmatHW<float16_t, 16, 16> converted[2];
    MatBox box;
    coopmatHW<float16_t, 16, 16> D0, D1, D2, D3;

    coopMatLoadHW(lhs[0], buf.data, shape, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    coopMatLoadHW(lhs[1], buf.data, shape, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    coopMatLoadHW(rhs[0], buf.data, shape, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    coopMatLoadHW(rhs[1], buf.data, shape, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    coopMatLoadHW(acc[0], buf.data, shape, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    coopMatLoadHW(acc[1], buf.data, shape, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    coopMatLoadHW(box.value, buf.data, shape, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);

    coopMatMulAddHW(D0, lhs[0], rhs[0], acc[0]);
    coopMatMulAddHW(D1, rhs[1], lhs[1], acc[1]);
    coopMatMulAddHW(D2, lhs[0], rhs[1], box.value);

    converted[0] = acc[0];
    converted[1] = box.value;
    coopMatMulAddHW(D3, converted[0], converted[1], acc[1]);
}
