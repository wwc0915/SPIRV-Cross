#version 450 core
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_HW_neural_shader : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Buf { float16_t data[]; } buf;

// Test 3: Accumulator and OperandAB roles separated by assignment boundary
// X is used as accumulator only. Y is a different GLSL variable assigned from X
// and then used as OperandAB, so the pass must insert a legal type conversion at
// the store boundary.
void main()
{
    const ivec2 shape16 = ivec2(16, 16);
    const ivec2 zeroOffset = ivec2(0, 0);

    coopmatHW<float16_t, 16, 16> X, Y;
    coopmatHW<float16_t, 16, 16> A, B, C1;
    coopmatHW<float16_t, 16, 16> D0, D1;

    coopMatLoadHW(X,  buf.data, shape16, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    coopMatLoadHW(A,  buf.data, shape16, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    coopMatLoadHW(B,  buf.data, shape16, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    coopMatLoadHW(C1, buf.data, shape16, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);

    // X used as accumulator.
    coopMatMulAddHW(D0, A, B, X);

    // Y is a new variable and can independently become OperandAB.
    Y = X;
    coopMatMulAddHW(D1, Y, B, C1);
}
