#version 450 core
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_HW_neural_shader : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

// Array of matrices used by vec matmul operations.
// Element accesses propagate UseB to the array storage key,
// so the entire array should become MatrixUseBHW.
void main()
{
    coopvecHW<float16_t, 16> v0, v1, v2, bias;
    coopmatHW<float16_t, 16, 16> mats[3];

    // mats[0]: matrix in coopVecMatMulHW -> UseB
    coopVecMatMulHW(v0, v1, mats[0]);

    // mats[1]: matrix in coopVecMatMulAddHW -> UseB
    coopVecMatMulAddHW(v1, v2, mats[1], bias);

    // mats[2]: matrix in coopVecMatMulHW -> UseB
    coopVecMatMulHW(v2, v0, mats[2]);
}
