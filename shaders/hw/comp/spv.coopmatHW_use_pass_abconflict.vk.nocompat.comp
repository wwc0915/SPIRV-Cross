#version 450 core
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_HW_neural_shader : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Buf { float16_t data[]; } buf;

// Test 2: AB conflict resolution
// Matrix X(16x16) used as left operand twice and right operand once
// left_count(2) >= right_count(1) → MatrixUseAHW
void main()
{
    const ivec2 shape16 = ivec2(16, 16);
    const ivec2 zeroOffset = ivec2(0, 0);

    coopmatHW<float16_t, 16, 16> X;
    coopmatHW<float16_t, 16, 16> B, C, C2;
    coopmatHW<float16_t, 16, 16> D0, D1, D2;

    coopMatLoadHW(X,  buf.data, shape16, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    coopMatLoadHW(B,  buf.data, shape16, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    coopMatLoadHW(C,  buf.data, shape16, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    coopMatLoadHW(C2, buf.data, shape16, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);

    // X used as left: left_count += 2
    coopMatMulAddHW(D0, X, B, C);
    coopMatMulAddHW(D1, X, B, C2);
    // X used as right: right_count += 1
    coopMatMulAddHW(D2, B, X, C);
}
